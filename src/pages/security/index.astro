	<Section variant="gradient" padding="xl">
		<div class="text-center">
			<Badge variant="error" class="mb-6"><span data-i18n="security.badge">OWASP AI Security — Agentic Apps 2026 + EU AI Act</span></Badge>
			<h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold mb-6 text-slate-50">
				<span data-i18n="security.hero.title1">Security</span> <span class="bg-clip-text text-transparent bg-saba-gradient" data-i18n="security.hero.title2">Audit</span>
			</h1>
			<p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed" data-i18n="security.hero.subtitle">
				Security that ships with your code
			</p>
			<p class="text-lg text-slate-400 mb-12 max-w-2xl mx-auto" data-i18n="security.hero.desc">
				Our AI security agents scan every commit, every dependency, every container — catching vulnerabilities before they reach production. With human oversight from seasoned DevSecOps engineers.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<Button variant="primary" size="lg" href="/contact" data-i18n="security.hero.cta1">Book Security Assessment</Button>
				<Button variant="outline" size="lg" href="#services" data-i18n="security.hero.cta2">Explore Services</Button>
			</div>
		</div>
	</Section>

