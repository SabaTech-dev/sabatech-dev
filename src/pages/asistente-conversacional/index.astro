---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Badge from "../../components/Badge.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Asistente Conversacional de Voz",
  applicationCategory: "CommunicationsApplication",
  operatingSystem: "Linux, Windows",
  description: "Conversational voice assistant running 100% offline. Real-time pipeline ASR (Qwen3-ASR) → LLM (llama.cpp + Gemma 4 12B QAT + MTP) → TTS (Supertonic 3 / Kokoro / Edge / Piper / Qwen3) with WebSocket streaming and barge-in.",
  url: "https://sabatech.dev/asistente-conversacional",
  offers: [
    {
      "@type": "Offer",
      name: "Core",
      price: "0",
      priceCurrency: "EUR",
      description: "PolyForm Noncommercial — free for research, education, hobby and public sector.",
    },
    {
      "@type": "Offer",
      name: "Enterprise",
      priceCurrency: "EUR",
      description: "Multi-tenant outbound deployment with concurrent calls, SIP trunking and on-premise installation.",
    },
  ],
  author: { "@type": "Organization", name: "SabaTech", url: "https://sabatech.dev" },
};
---

<Layout
