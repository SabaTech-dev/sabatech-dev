					<svg aria-hidden="true" class="w-5 h-5 text-teal-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
					</svg>
					<span><strong class="text-slate-200" data-i18n="qa.roadmap.q4">Q4 2026:</strong> <span data-i18n="qa.roadmap.q4.desc">Public GA with pricing tiers</span></span>
