				<h2 class="text-3xl md:text-4xl font-bold mb-6 text-slate-50" data-i18n="qa.workflow.title">Workflow</h2>
			<div class="space-y-6">
				<div class="flex gap-4">
					<div class="w-10 h-10 rounded-full bg-saba-gradient text-white flex items-center justify-center shrink-0 font-bold">1</div>
					<div>
						<h3 class="text-lg font-semibold mb-2 text-slate-50" data-i18n="qa.workflow.step1.title">Define Test Cases</h3>
						<p class="text-slate-400" data-i18n="qa.workflow.step1.desc">Create and organize test cases in the dashboard. Prioritize by risk and complexity.</p>
					</div>
				</div>
				<div class="flex gap-4">
					<div class="w-10 h-10 rounded-full bg-saba-gradient text-white flex items-center justify-center shrink-0 font-bold">2</div>
					<div>
						<h3 class="text-lg font-semibold mb-2 text-slate-50" data-i18n="qa.workflow.step2.title">Automate Execution</h3>
						<p class="text-slate-400" data-i18n="qa.workflow.step2.desc">Run tests automatically in CI/CD or on-demand. Smart parallelization.</p>
